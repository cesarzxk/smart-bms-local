# ===== Rede local =====
# Interface ligada à LAN (deixe vazio para auto-detectar)
BMS_IFACE=
# IP desta máquina na LAN (deixe vazio para auto-detectar)
BMS_HOST_IP=
# IP e MAC do dongle Wi-Fi/BT do BMS (o MAC aparece no DHCP do roteador)
BMS_DONGLE_IP=
BMS_DONGLE_MAC=
# Gateway (deixe vazio para auto-detectar)
BMS_GATEWAY_IP=
BMS_GATEWAY_MAC=

# ===== Dongle / nuvem do fabricante =====
BMS_REAL_HOST=public.iot-as-mqtt.us-east-1.aliyuncs.com
BMS_REAL_PORT=1883
# ProductKey e DeviceName aparecem no CONNECT do dongle (veja o log do proxy)
BMS_PRODUCT_KEY=
BMS_DEVICE_NAME=
# Intervalo de polling em segundos
BMS_POLL_INTERVAL=30
# Comandos Modbus (hex) usados para pedir dados e temperaturas
BMS_POLL_CMD_DATA=D2030000007ED649
BMS_POLL_CMD_TEMP=D203008000705665

# ===== MQTT / Home Assistant =====
MQTT_HOST=127.0.0.1
MQTT_PORT=1884
MQTT_PREFIX=bms
MQTT_DISCOVERY=homeassistant
BMS_NAME=BMS 8S 24V
BMS_ID=bms8s

# ===== Sistema =====
TZ=America/Sao_Paulo
