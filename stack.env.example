# Cole estes valores em Portainer -> Stacks -> Environment variables
BMS_DONGLE_IP=
BMS_DONGLE_MAC=
BMS_PRODUCT_KEY=
BMS_DEVICE_NAME=
# Opcionais (auto-detectados se vazios)
BMS_HOST_IP=
BMS_IFACE=
BMS_GATEWAY_IP=
BMS_GATEWAY_MAC=
# Dongle / nuvem do fabricante
BMS_REAL_HOST=public.iot-as-mqtt.us-east-1.aliyuncs.com
BMS_REAL_PORT=1883
BMS_POLL_INTERVAL=30
BMS_POLL_CMD_DATA=D2030000007ED649
BMS_POLL_CMD_TEMP=D203008000705665
# MQTT / Home Assistant
MQTT_PREFIX=bms
MQTT_DISCOVERY=homeassistant
BMS_NAME=BMS 8S 24V
BMS_ID=bms8s
TZ=America/Sao_Paulo
